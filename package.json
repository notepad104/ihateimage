{
  "name": "ihateimage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist/server && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "audit": "npm audit --audit-level=high",
    "docker:build": "docker build -t ihateimage .",
    "docker:run": "docker run --rm -p 8080:8080 ihateimage"
  },
  "dependencies": {
    "jszip": "3.10.2",
    "lucide-react": "1.47.0",
    "onnxruntime-web": "1.21.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "7.18.4",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "4.3.3",
    "typescript": "~5.8.0",
    "vite": "^6.3.0"
  }
}
